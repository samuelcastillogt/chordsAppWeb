# ChordWeaver web — copy to `.env.local` for local development (`cp .env.example .env.local`).
# All variables are public (NEXT_PUBLIC_*): they are inlined in the browser bundle at build time.
# In GitHub Actions they come from the github-pages environment's Variables (Settings > Environments > github-pages).

# --- API --------------------------------------------------------------------
# Defaults to the production API (https://chords-api-python.vercel.app) when empty.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Path prefix the app is served under. Set automatically by the GitHub Pages workflow.
NEXT_PUBLIC_BASE_PATH=

# --- Site -------------------------------------------------------------------
# Public URL of the deployed site, used for canonical links, sitemap.xml and social previews.
# Defaults to https://samuelcastillogt.github.io/chordsAppWeb when empty.
NEXT_PUBLIC_SITE_URL=
# Contact address shown in the privacy policy, terms and account-deletion pages.
# Empty shows a link to the repository's GitHub issues instead.
NEXT_PUBLIC_CONTACT_EMAIL=
# Search Console > Add property (URL prefix) > HTML tag: the value of `content` only.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Firebase Authentication ------------------------------------------------
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# Required (accounts stay hidden until these four are set):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional:
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Google Analytics 4 stream of the Firebase web app (G-XXXXXXX). Enables the product events
# (analyze, save, share, sign_up, pro_click, begin_checkout...). Empty disables analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local Firebase Auth emulator (`firebase emulators:start --only auth`), e.g. 127.0.0.1:9099.
# Leave empty to use the real Firebase project.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# --- Monitoring --------------------------------------------------------------
# Sentry project DSN (public by design). Empty disables browser error monitoring.
# Open any page with ?probar-monitoreo=1 to send a test message.
NEXT_PUBLIC_SENTRY_DSN=
